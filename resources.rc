#define Filename "pdx-flag-builder.exe"
#define FileDescription "PDX Flag Builder"
#define ProductName "PDX Flag Builder"

#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
#pragma code_page(65001)

#define IDI_ICON1                       101

#define Q(x) #x
#define QUOTE(x) Q(x)
#define FMTVER(x,y,z) QUOTE(x.y.z)

#ifndef V1
#define V1 1
#endif
#ifndef V2
#define V2 1
#endif
#ifndef V3
#define V3 1
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION V1,V2,V3
 PRODUCTVERSION V1,V2,V3
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0409FDE9"
        BEGIN
            VALUE "CompanyName", "https://github.com/kaiser-chris/pdx-flag-builder"
            VALUE "FileDescription", "PDX Flag Builder"
            VALUE "FileVersion", FMTVER(V1,V2,V3)
            VALUE "InternalName", "pdx-flag-builder.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 Chris Kaiser. All rights reserved."
            VALUE "OriginalFilename", "pdx-flag-builder.exe"
            VALUE "ProductName", "PDX Flag Builder"
            VALUE "ProductVersion", FMTVER(V1,V2,V3)
            VALUE "Comments", FMTVER(V1,V2,V3)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        //0xFDE9=65001=CP_UTF8
        VALUE "Translation", 0x0409, 0xFDE9
    END
END

IDI_ICON1 ICON "icon.ico"